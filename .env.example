# MCP Software Engineering Agent Environment Configuration
# Copy this file to .env and fill in the values as appropriate.

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Workspace / Task Sandbox Root
WORKSPACE_ROOT=./workspace

# Execution Timeouts (in seconds)
DEFAULT_TASK_TIMEOUT=300
TEST_EXECUTION_TIMEOUT=60

# Optional Model Provider Configuration (MCP client remains provider-agnostic)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
